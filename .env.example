# Server-only. Never commit a real key, never use in client code.
MODEL_API_KEY=
# Optional overrides (defaults shown). Switch provider by changing these only.
MODEL_BASE_URL=https://api.meta.ai/v1
CHAT_MODEL=muse-spark-1.3
ADVENBOOK_MCP_URL=https://www.advenbook.com/api/mcp
# Daily LLM budget across all visitors, in tokens (input + output).
# Muse Spark standard: $1.25 / 1M input, $4.25 / 1M output.
# 5,000,000 tokens/day ≈ at most ~$7-21/day depending on the in/out mix.
# One average book conversation is roughly 100k-250k tokens (~$0.15-$0.35).
DAILY_TOKEN_BUDGET=5000000
# Per-visitor daily slice of that budget (anonymous, signed cookie).
# A bot can only ever burn this much per day; Strava-connected or
# human-verified visitors get 5x. 250k tokens ≈ ~$0.40 worst case.
VISITOR_DAILY_TOKEN_BUDGET=250000
# Signs the anonymous visitor cookie. Defaults to MODEL_API_KEY if unset.
VISITOR_COOKIE_SECRET=
# Error/budget alerts. Set a Discord or Slack incoming webhook URL to
# receive errors and daily-budget alerts (50/80/100%) in real time.
# Without it, errors are structured JSON lines in the server logs.
ALERT_WEBHOOK_URL=
# Protects GET /api/metrics (the funnel: turns -> books -> order clicks).
# Pick any long random string; without it the endpoint is disabled.
METRICS_TOKEN=
# Optional human check (Cloudflare Turnstile, free). Shown ONLY when an
# anonymous visitor hits the visitor cap. Create both keys at
# dash.cloudflare.com > Turnstile; the NEXT_PUBLIC one is public.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional shared store so the budget/rate limits hold across server
# instances (Vercel KV or Upstash Redis REST). Without it, counters are
# in-memory per instance.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Photo uploads (M2): create a Vercel Blob store and paste its token. Without
# it, photos are analysed/cropped but cannot be sent to the book yet.
BLOB_READ_WRITE_TOKEN=
VOICE_MODEL=muse-voice-transcribe-1.0
SAM_MODEL=sam-3.1
